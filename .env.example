# Copy to .env and fill in. See developer.md and GUARDIAN_ANGEL_SPEC.md §8.

# Required for POST /api/v1/transmissions (Bearer or X-Guardian-Angel-Token)
GUARDIAN_ANGEL_API_SECRET=

# Optional alternate name (spec §7)
# GUARDIAN_ANGEL_SHARED_SECRET=

# Firestore — omit to run UI with demo data only (API reads empty; POST ingestion disabled without DB)
FIREBASE_PROJECT_ID=

# Service account JSON path (local / mounted in Docker). Required for Firestore unless using ADC on GCP.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional — Firestore collection id for POST/GET /api/v1/medicnotes (default: Medic Notes)
# GUARDIAN_ANGEL_MEDIC_NOTES_COLLECTION=Medic Notes

# Optional
TRIAGE_SYSTEM_LABEL=SALT
GUARDIAN_ANGEL_HOST=127.0.0.1
GUARDIAN_ANGEL_PORT=8000

# Build metadata (e.g. CI)
# GIT_SHA=
